{
  // Source of truth is src/spider.ts. The build emits spider.js next to
  // index.html so the demo runs on any static server. Do not edit
  // spider.js by hand — change src/spider.ts and run `npm run build`.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "."
  },
  "include": ["src"]
}
